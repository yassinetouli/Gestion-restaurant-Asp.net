@inject IHttpContextAccessor HttpContextAccessor
@{
    var username = HttpContextAccessor.HttpContext.Session.GetString("Username");
}


@model List<ProduitIndexViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Home";

    string ResolvePath(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return Url.Content("~/images/product-placeholder.jpg");
        return path.StartsWith("~") ? Url.Content(path) : Url.Content("~/" + path.TrimStart('/'));
    }
}

