<!-- food section -->
<section class="food_section layout_padding-bottom">
    <div class="container">
        <div class="heading_container heading_center">
            <h2>Our Menu</h2>
        </div>

        <!-- FILTER MENU -->
        <ul class="filters_menu">
            <li class="active" data-bs-filter="*">All</li>
            <li data-bs-filter=".burger">Burger</li>
            <li data-bs-filter=".pizza">Pizza</li>
            <li data-bs-filter=".pasta">Pasta</li>
            <li data-bs-filter=".fries">Fries</li>
        </ul>

        <div class="filters-content">
            <div class="row grid">

                @if (Model != null && Model.Count > 0)
                {
                    foreach (var produit in Model)
                    {
                        <div class="col-sm-6 col-lg-4 all">
                            <div class="box">
                                <div>
                                    <div class="img-box">
                                        <img src="@produit.ImageUrl" alt="@produit.Nom" class="img-fluid">
                                    </div>

                                    <div class="detail-box">
                                        <h5>@produit.Nom</h5>

                                        <p>
                                            @produit.Description
                                        </p>

                                        <div class="options">
                                            <h6>
                                                @produit.Prix €
                                            </h6>

                                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#commandeModal@produit.Id">
                                                🛒 
                                            </button>
                                        </div>
                                        <!-- Modal -->
                                        <div class="modal fade" id="commandeModal@produit.Id" tabindex="-1" aria-labelledby="commandeModalLabel@produit.Id" aria-hidden="true">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="commandeModalLabel@produit.Id">Commander @produit.Nom</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <form asp-controller="Commande" asp-action="Create" method="post">
                                                            <input type="hidden" name="ProduitId" value="@produit.Id" />

                                                            <div class="mb-2">
                                                                <label>Quantité</label>
                                                                <input type="number" name="Quantite" value="1" min="1" class="form-control" />
                                                            </div>
                                                            <div class="mb-2">
                                                                <label>Nom et prenom</label>
                                                                <input type="text" name="username" class="form-control" placeholder="Nom" />
                                                            </div>
                                                            <div class="mb-2">
                                                                <label>Adresse</label>
                                                                <input type="text" name="Adresse" class="form-control" placeholder="Adresse" />
                                                            </div>

                                                            <button type="submit" class="btn btn-success w-100">Confirmer la commande</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center">
                        <div class="alert alert-warning">
                            Aucun produit disponible
                        </div>
                    </div>
                }

            </div>
        </div>

        <div class="btn-box">
            <a asp-controller="Product" asp-action="Index">
                View More
            </a>
        </div>
    </div>
</section>
<!-- end food section -->
