@using SiteWeb.Entity
@model List<SiteWeb.Models.CommandeDetailModel>

@{
    ViewData["Title"] = "Admin";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/style.min.css" rel="stylesheet" />
    <link href="~/css/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
</head>

<body class="sb-nav-fixed">

    <!-- TOP NAVBAR -->
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
        <a class="navbar-brand ps-3" href="#">Admin Panel</a>
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4" id="sidebarToggle">
            <i class="fas fa-bars"></i>
        </button>

        <ul class="navbar-nav ms-auto me-3">
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                    <i class="fas fa-user fa-fw"></i>
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#">Settings</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#">Logout</a></li>
                </ul>
            </li>
        </ul>
    </nav>

    <div id="layoutSidenav">

        <!-- SIDEBAR -->
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark">
                <div class="sb-sidenav-menu">
                    <div class="nav">

                        <div class="sb-sidenav-menu-heading">Core</div>
                        <a class="nav-link" href="#">
                            <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                            Dashboard
                        </a>

                        <div class="sb-sidenav-menu-heading">Management</div>

                        <a class="nav-link" href="#">
                            <div class="sb-nav-link-icon"><i class="fas fa-box"></i></div>
                            Products
                        </a>

                        <a class="nav-link" href="#">
                            <div class="sb-nav-link-icon"><i class="fas fa-plus"></i></div>
                            Add Product
                        </a>

                    </div>
                </div>

                <div class="sb-sidenav-footer">
                    <div class="small">Logged in as:</div>
                    Livreur
                </div>
            </nav>
        </div>

        <!-- MAIN CONTENT -->
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">

                    <h1 class="mt-4">Livreur dashboard</h1>
                    <ol class="breadcrumb mb-4">
                        <li class="breadcrumb-item active">Manage Products</li>
                    </ol>

                    <!-- COMMANDES TABLE -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <i class="fas fa-box me-1"></i>
                            Commandes en attente
                        </div>

                        <div class="card-body">
                            @if (Model != null && Model.Any())
                            {
                                <table id="datatablesSimple" class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>N° Commande</th>
                                            <th>Produit</th>
                                            <th>Client</th>
                                            <th>Adresse</th>
                                            <th>Quantité</th>
                                            <th>Prix Unitaire</th>
                                            <th>Total Ligne</th>
                                            <th>Statut</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.CommandeId</td>
                                                <td>@item.ProduitNom</td>
                                                <td>@item.Username</td>
                                                <td>@item.Adresse</td>
                                                <td>@item.Quantite</td>
                                                <td>@item.PrixUnitaire.ToString("F2") DH</td>
                                                <td>@item.TotalLigne.ToString("F2") DH</td>
                                                <td>
                                                    @if (item.Statut == TypeCommande.EnAttente)
                                                    {
                                                        <span class="badge bg-warning">@item.Statut</span>
                                                    }
                                                    else if (item.Statut == TypeCommande.EnLivraison)
                                                    {
                                                        <span class="badge bg-info">@item.Statut</span>
                                                    }
                                                    else if (item.Statut == TypeCommande.Livree)
                                                    {
                                                        <span class="badge bg-success">@item.Statut</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">@item.Statut</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.Statut == TypeCommande.EnAttente)
                                                    {
                                                        <form asp-controller="Livreur" asp-action="AcceptCommande" method="post" style="display:inline;">
                                                            <input type="hidden" name="commandeId" value="@item.CommandeId" />
                                                            <button type="submit" class="btn btn-success btn-sm">Accepter</button>
                                                        </form>
                                                    }
                                                    else if (item.Statut == TypeCommande.EnLivraison)
                                                    {
                                                        <form asp-controller="Livreur" asp-action="MarquerLivree" method="post" style="display:inline;">
                                                            <input type="hidden" name="commandeId" value="@item.CommandeId" />
                                                            <button type="submit" class="btn btn-primary btn-sm">Livrée</button>
                                                        </form>
                                                    }
                                                    else if (item.Statut == TypeCommande.Livree)
                                                    {
                                                        <span class="badge bg-success">Livrée</span>
                                                    }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="alert alert-info">
                                    Aucune commande en attente pour le moment.
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </main>

            <!-- FOOTER -->
            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex justify-content-between small">
                        <div class="text-muted">© 2026 Your Website</div>
                        <div>
                            <a href="#">Privacy</a> · <a href="#">Terms</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scripts.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js"></script>
    <script>
        const table = document.querySelector("#datatablesSimple");
        if (table) {
            new simpleDatatables.DataTable(table);
        }
    </script>

</body>
</html>
